{
  "name": "vibehub-plugin",
  "version": "0.8.0",
  "private": true,
  "description": "Lightweight Skill-first Git-native Tickets and durable project Context.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-plugin-artifact.mjs --out dist/plugin",
    "build:dsh": "node scripts/build-dsh-bundle.mjs --out dist/dsh-vibehub --clean",
    "probe:dsh": "node packages/dsh-adapter/probe-source.mjs",
    "probe:dsh-shell": "node packages/dsh-adapter/probe-persistent-shell.mjs",
    "prototype:directions": "node scripts/vh-harness-directions.mjs",
    "prototype:directions:safari": "node scripts/vh-harness-directions.mjs --safari",
    "prototype:interaction-research": "node scripts/vh-harness-interaction-research.mjs",
    "prototype:taste": "node scripts/vh-harness-taste-board.mjs",
    "prototype:chat": "node scripts/vh-harness-chat-v1.mjs",
    "prototype:codex-base": "node scripts/vh-harness-codex-base.mjs",
    "prototype:dsh-shell": "node scripts/vh-dsh-persistent-shell-prototype.mjs",
    "prototype:harness": "node scripts/vh-harness-prototype.mjs",
    "prototype:harness:safari": "node scripts/vh-harness-prototype.mjs --safari",
    "test": "node --test test/*.test.mjs",
    "verify:artifact": "node scripts/verify-plugin-artifact.mjs",
    "verify": "node --test test/*.test.mjs && node scripts/verify-plugin-artifact.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VW-ai/vibehub-plugin.git"
  },
  "homepage": "https://github.com/VW-ai/vibehub-plugin#readme"
}
