{
  "schema_version": 1,
  "proposal": "codex-like-workbench-v1",
  "typography": {
    "family_ui": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "family_mono": "SFMono-Regular, Consolas, Liberation Mono, monospace",
    "size_caption": 11,
    "size_body": 13,
    "size_title": 16,
    "size_display": 20,
    "weight_regular": 400,
    "weight_medium": 520,
    "weight_semibold": 620,
    "line_compact": 1.25,
    "line_reading": 1.5
  },
  "spacing": {
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32
  },
  "radii": {
    "control": 8,
    "card": 10,
    "panel": 14,
    "pill": 999
  },
  "border": {
    "subtle": "#e2e2de",
    "strong": "#c8c8c2",
    "selection": "#252523",
    "focus": "#2f6fdb",
    "width": 1,
    "selection_width": 2,
    "focus_width": 3
  },
  "elevation": {
    "canvas": "none",
    "card": "0 1px 2px rgba(27, 27, 25, 0.05)",
    "floating": "0 10px 30px rgba(27, 27, 25, 0.10), 0 2px 8px rgba(27, 27, 25, 0.06)",
    "inspector": "-12px 0 32px rgba(27, 27, 25, 0.08)"
  },
  "surface": {
    "app": "#f7f7f5",
    "canvas": "#fafaf8",
    "panel": "#ffffff",
    "muted": "#f1f1ee",
    "raised": "#ffffff",
    "ink": "#252523",
    "secondary": "#6d6d68",
    "tertiary": "#969690"
  },
  "semantic": {
    "done": { "surface": "#f0f3f0", "accent": "#496351", "label": "DONE", "icon": "check" },
    "ready": { "surface": "#edf4ff", "accent": "#3267a8", "label": "READY", "icon": "play" },
    "blocked": { "surface": "#fff4df", "accent": "#895d0a", "label": "BLOCKED", "icon": "lock" },
    "refine": { "surface": "#f5efff", "accent": "#74509b", "label": "REFINE", "icon": "sliders" },
    "deviated": { "surface": "#fff0ee", "accent": "#a7433b", "label": "DEVIATED", "icon": "alert-triangle" },
    "archived": { "surface": "#f3f3f0", "accent": "#5f5f5a", "label": "ARCHIVED", "icon": "archive", "boundary": "dashed" }
  },
  "attention": {
    "upcoming": { "surface": "transparent", "accent": "#6d6d68", "label": "UPCOMING", "icon": "circle-dashed" },
    "pending": { "surface": "#fff4df", "accent": "#895d0a", "label": "NEEDS YOU", "icon": "hand" },
    "recorded": { "surface": "#edf4ff", "accent": "#3267a8", "label": "DECISION NOTED", "icon": "bookmark-check" },
    "complete": { "surface": "#f0f3f0", "accent": "#496351", "label": "COMPLETE", "icon": "check-check" }
  },
  "interaction": {
    "hover": "neutral surface lift plus border; never state-color mutation",
    "focus": "3px blue outer ring plus 2px canvas separation",
    "selection": "2px neutral ink outline; state surface remains visible",
    "reduced_motion": "all transitions disabled when prefers-reduced-motion is reduce",
    "target_default": 36,
    "target_narrow": 44,
    "icon_size": 16,
    "icon_stroke": 1.6
  }
}
