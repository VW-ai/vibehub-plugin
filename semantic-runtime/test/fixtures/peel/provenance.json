  "locator_contract": {
    "codex_turn": {
      "scheme": "peel-codex-turn://sha256:<digest>",
      "digest": "SHA-256 over UTF-8 <raw-thread-id>:<raw-turn-id>:<turn_started|turn_completed>",
      "resolver": "scripts/verify-peel-provenance.mjs matches phase and source_available_at from an ignored local turn index"
    },
    "git": {
      "scheme": "peel-git://<commit>/<repository-relative-path>",
      "identity": "git:<commit>:<blob>",
      "resolver": "scripts/verify-peel-provenance.mjs --source-repo <Peel checkout>",
      "time": "Commit committer time, except VibeHub Outcomes use their closed_at field"
    },
    "local_record": {
      "scheme": "peel-record://<ticket|outcome>/<id>@sha256:<digest>",
      "digest": "SHA-256 over exact source file bytes",
      "resolver": "scripts/verify-peel-provenance.mjs --source-repo <Peel checkout>",
