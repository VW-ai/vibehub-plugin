{
  "name": "@vibehub/semantic-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental semantic runtime for persistent understanding of development work.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/local/cli.mjs",
    "app": "node src/local/cli.mjs --setup",
    "status": "node src/local/cli.mjs --status",
    "test": "node --test test/*.test.mjs",
    "test:host-probes": "node --test research/host-probes/codex/test/codex-host-probe.test.mjs research/host-probes/claude/test/claude-host-probe.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run check:boundaries && npm test",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:peel:provenance": "node scripts/verify-peel-provenance.mjs",
    "example:gateway": "node --experimental-strip-types --env-file=.env.local research/examples/ai-gateway/index.ts",
    "smoke:jev": "node --env-file=.env.local scripts/smoke-jev.mjs",
    "smoke:jev:direct": "node --env-file=.env.local scripts/smoke-typesafe-direct.mjs",
    "check:jev:synthetic": "node scripts/check-jev-synthetic.mjs",
    "smoke:jev:openrouter": "node scripts/smoke-openrouter-jev.mjs",
    "replay": "node src/cli.mjs replay",
    "replay:jev": "node --env-file=.env.local src/cli.mjs replay --judge jev",
    "replay:peel": "node src/cli.mjs replay --events test/fixtures/peel/events.jsonl --state test/fixtures/peel/state.json --labels test/fixtures/peel/labels.json --tenant benchmark --project peel --dataset-kind real --db .local/peel-replay-v3.sqlite",
    "benchmark:peel:jev": "node --env-file=.env.local scripts/benchmark-peel-jev.mjs",
    "benchmark:peel:jev:direct": "node --env-file=.env.local scripts/benchmark-peel-typesafe-direct.mjs",
    "benchmark:peel:jev:routes": "node scripts/compare-peel-jev-routes.mjs",
    "benchmark:peel:compare": "node scripts/compare-peel-judges.mjs --transport claude-cli",
    "benchmark:peel:compare:gateway": "node --env-file=.env.local scripts/compare-peel-judges.mjs --transport gateway",
    "audit": "node src/cli.mjs audit",
    "compare": "node src/cli.mjs compare",
    "check:jev:ingress": "node scripts/check-jev-ingress.mjs",
    "check:jev:graph": "node scripts/check-jev-ingress.mjs --graph",
    "check:jev:source-fence": "node scripts/check-jev-source-fence.mjs",
    "check:jev:exploration": "node scripts/check-jev-exploration.mjs",
    "check:jev:judge": "node scripts/check-jev-judge.mjs",
    "check:jev:adoption": "node scripts/check-jev-adoption.mjs",
    "check:jev:context": "node scripts/check-jev-context.mjs",
    "check:jev:query": "node scripts/check-jev-query.mjs",
    "probe:codex:live": "node research/host-probes/codex/probe-codex-host.mjs --live-synthetic",
    "probe:claude:live": "node research/host-probes/claude/probe-claude-host.mjs --live-synthetic"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "7.0.107"
  }
}
