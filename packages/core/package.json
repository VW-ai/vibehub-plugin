{
  "name": "@vw-ai/vibehub-core",
  "version": "0.2.2",
  "description": "Vibehub workbench core — library-first, zero-LLM (decision-project-013/025). All real logic lives here; cli/mcp are thin adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./contracts/ticket-review-schemas": {
      "types": "./dist/contract/ticket-review-schemas.d.ts",
      "default": "./dist/contract/ticket-review-schemas.js"
    },
    "./contracts/ticket-proposal-schemas": {
      "types": "./dist/contract/ticket-proposal-schemas.d.ts",
      "default": "./dist/contract/ticket-proposal-schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VW-ai/vibehub-plugin.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/VW-ai/vibehub-plugin#readme",
  "bugs": {
    "url": "https://github.com/VW-ai/vibehub-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
