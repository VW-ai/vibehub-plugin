{
  "name": "@vw-ai/vibehub-cli",
  "version": "0.3.0",
  "description": "Vibehub workbench CLI — thin adapter over @vw-ai/vibehub-core (decision-project-013: zero LLM, zero business logic; parsing + output formatting only).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "vibehub": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VW-ai/vibehub-plugin.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/VW-ai/vibehub-plugin#readme",
  "bugs": {
    "url": "https://github.com/VW-ai/vibehub-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-operation-contracts.mjs && node scripts/copy-managed-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vw-ai/vibehub-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ajv": "^8.18.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
