{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/epic.v1.json",
  "title": "VibeHub Epic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "epic_id",
    "title",
    "context_refs",
    "provenance_refs",
    "goal_id",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "epic"
    },
    "epic_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "purpose"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "provenance_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
