{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/ticket.v3.json",
  "title": "VibeHub Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "ticket_id", "revision_state", "outcome", "deliveries", "context", "acceptance", "constraints", "context_refs", "relations", "provenance_refs"],
  "properties": {
    "schema_version": { "const": 3 },
    "kind": { "const": "ticket" },
    "ticket_id": { "$ref": "#/$defs/id" },
    "revision_state": { "enum": ["bound", "legacy-pending-reconstruction"] },
    "active_contract_revision": { "$ref": "#/$defs/revision" },
    "contract_revisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract_revision" }
    },
    "maturity": { "enum": ["firm", "draft"], "default": "firm" },
    "outcome": { "$ref": "#/$defs/text" },
    "deliveries": { "type": "array", "default": [], "items": { "$ref": "#/$defs/delivery" } },
    "context": { "$ref": "#/$defs/text" },
    "acceptance": { "type": "array", "minItems": 1 },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "purpose"],
        "properties": {
          "ref": {
            "$ref": "#/$defs/text",
            "description": "Current repository path or immutable commit:<40-lowercase-hex>:<repo-relative-path> reference resolved by the shared context resolver."
          },
          "purpose": { "$ref": "#/$defs/text" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_ticket_id"],
        "properties": {
          "type": { "const": "depends_on" },
          "target_ticket_id": { "$ref": "#/$defs/id" },
          "rationale": { "$ref": "#/$defs/text" }
        }
      }
    },
    "provenance_refs": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  },
  "allOf": [
    {
      "if": { "properties": { "revision_state": { "const": "bound" } } },
      "then": {
        "required": ["active_contract_revision", "contract_revisions"],
        "properties": { "acceptance": { "items": { "$ref": "#/$defs/acceptance_revision" } } }
      },
      "else": {
        "not": { "anyOf": [{ "required": ["active_contract_revision"] }, { "required": ["contract_revisions"] }] },
        "properties": { "acceptance": { "items": { "$ref": "#/$defs/legacy_acceptance" } } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "revision": { "type": "integer", "minimum": 1 },
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "acceptance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "revision", "identity"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "identity": { "$ref": "#/$defs/identity" }
      }
    },
    "lineage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "revision"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "acceptance_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "revision", "identity", "criterion", "state"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "identity": { "$ref": "#/$defs/identity" },
        "criterion": { "$ref": "#/$defs/text" },
        "authority": { "enum": ["agent", "human"], "default": "agent" },
        "state": { "enum": ["active", "retired"] },
        "derived_from": { "type": "array", "items": { "$ref": "#/$defs/lineage_ref" }, "uniqueItems": true },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "legacy_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "criterion"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/id" },
        "criterion": { "$ref": "#/$defs/text" },
        "authority": { "enum": ["agent", "human"], "default": "agent" }
      }
    },
    "contract_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "identity", "acceptance_revisions"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "identity": { "$ref": "#/$defs/identity" },
        "acceptance_revisions": { "type": "array", "items": { "$ref": "#/$defs/acceptance_ref" }, "uniqueItems": true }
      }
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit_ref": { "type": "string", "pattern": "^commit:[0-9a-f]{40}$" },
    "pull_request_ref": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$" },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "state"],
          "properties": {
            "kind": { "const": "pull_request" },
            "ref": { "$ref": "#/$defs/pull_request_ref" },
            "state": { "enum": ["proposed", "delivered", "abandoned"] },
            "delivered_at": { "type": "string", "format": "date-time" },
            "delivered_commit": { "$ref": "#/$defs/commit" },
            "reverted_by": { "$ref": "#/$defs/commit_ref" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "state", "delivered_at", "delivered_commit"],
          "properties": {
            "kind": { "const": "cherry_pick" },
            "ref": { "$ref": "#/$defs/commit_ref" },
            "state": { "const": "delivered" },
            "delivered_at": { "type": "string", "format": "date-time" },
            "delivered_commit": { "$ref": "#/$defs/commit" },
            "reverted_by": { "$ref": "#/$defs/commit_ref" }
          }
        }
      ]
    }
  }
}
