{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/ticket.v2.json",
  "title": "VibeHub Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "ticket_id", "outcome", "deliveries", "context", "acceptance", "constraints", "context_refs", "relations", "provenance_refs"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "ticket" },
    "ticket_id": { "$ref": "#/$defs/id" },
    "maturity": {
      "type": "string",
      "enum": ["firm", "draft"],
      "default": "firm",
      "description": "Planning maturity. New or rewritten Tickets state firm or draft explicitly; omission remains legacy-compatible firm."
    },
    "outcome": { "$ref": "#/$defs/text" },
    "deliveries": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/delivery" }
    },
    "context": { "$ref": "#/$defs/text" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "criterion"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "criterion": { "$ref": "#/$defs/text" },
          "authority": {
            "type": "string",
            "enum": ["agent", "human"],
            "default": "agent",
            "description": "Who may judge this criterion. Omission means agent authority."
          }
        }
      }
    },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "purpose"],
        "properties": { "ref": { "$ref": "#/$defs/text" }, "purpose": { "$ref": "#/$defs/text" } }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_ticket_id"],
        "properties": {
          "type": { "const": "depends_on" },
          "target_ticket_id": { "$ref": "#/$defs/id" },
          "rationale": { "$ref": "#/$defs/text" }
        }
      }
    },
    "provenance_refs": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "origin": {
      "$ref": "#/$defs/origin",
      "description": "Canonical provenance of the harness Turn this Ticket was born from. Omission means no origin and is the only compatibility rule. Once a Ticket is checked in, its origin is immutable: ticket apply refuses to add, change, or remove it. Origin is recorded only from exact harness identity, never derived from Thread names, previews, or transcripts."
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "thread_id", "forked_from_id", "turn_id", "item_id", "selection", "captured_at"],
      "properties": {
        "harness": { "type": "string", "enum": ["codex"] },
        "thread_id": { "$ref": "#/$defs/text" },
        "forked_from_id": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "turn_id": { "$ref": "#/$defs/text" },
        "item_id": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "selection": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "text_sha256"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0, "description": "Must be greater than or equal to start; the validator enforces the ordering the schema cannot express." },
                "text_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "commit_ref": { "type": "string", "pattern": "^commit:[0-9a-f]{40}$" },
    "pull_request_ref": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$" },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "state"],
          "properties": {
            "kind": { "const": "pull_request" },
            "ref": { "$ref": "#/$defs/pull_request_ref" },
            "state": { "enum": ["proposed", "delivered", "abandoned"] },
            "delivered_at": { "type": "string", "format": "date-time" },
            "delivered_commit": { "$ref": "#/$defs/commit" },
            "reverted_by": { "$ref": "#/$defs/commit_ref" }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "delivered" } } },
              "then": { "required": ["delivered_at", "delivered_commit"] },
              "else": {
                "not": {
                  "anyOf": [
                    { "required": ["delivered_at"] },
                    { "required": ["delivered_commit"] },
                    { "required": ["reverted_by"] }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "state", "delivered_at", "delivered_commit"],
          "properties": {
            "kind": { "const": "cherry_pick" },
            "ref": { "$ref": "#/$defs/commit_ref" },
            "state": { "const": "delivered" },
            "delivered_at": { "type": "string", "format": "date-time" },
            "delivered_commit": { "$ref": "#/$defs/commit" },
            "reverted_by": { "$ref": "#/$defs/commit_ref" }
          }
        }
      ]
    }
  }
}
