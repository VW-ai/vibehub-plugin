{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/agent-session.v1.json",
  "title": "Local Agent session observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "session_id",
    "ticket_id",
    "agent_id",
    "agent_name",
    "provider",
    "host_session_id",
    "operation",
    "source",
    "state",
    "revision",
    "started_at",
    "last_reported_at",
    "last_activity_at",
    "expires_at",
    "ended_at",
    "freshness_ms",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "agent_session"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "host_session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "enum": [
        "execute",
        "closeout",
        "plan"
      ]
    },
    "source": {
      "enum": [
        "agent_report",
        "process"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "running",
        "waiting_tool",
        "waiting_human",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ended_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "ended_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
