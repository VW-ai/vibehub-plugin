{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/ticket-evidence.v2.json",
  "title": "VibeHub Ticket Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_id", "ticket_id", "acceptance_ids", "summary", "refs", "recorded_at"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "kind": { "const": "ticket_evidence" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "ticket_id": { "$ref": "#/$defs/id" },
    "acceptance_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "acceptance_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "One optional binding per referenced criterion: the sha256 digest of the exact acceptance semantics this Evidence evaluated, computed from [ticket_id, acceptance_id, authority, criterion] with the default agent authority explicit. Omission is the only legacy compatibility rule; a document without bindings stays readable but no longer satisfies current coverage under the binding-aware project format.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "digest", "binding"],
        "properties": {
          "acceptance_id": { "$ref": "#/$defs/id" },
          "digest": { "$ref": "#/$defs/sha256" },
          "binding": { "enum": ["native", "reconstructed"] },
          "provenance_ref": {
            "$ref": "#/$defs/commit_ref",
            "description": "Only for reconstructed bindings: the first current-ancestry Git addition the contract was read from. Provenance, never identity."
          }
        }
      }
    },
    "summary": { "$ref": "#/$defs/text" },
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "origin": {
      "type": "string",
      "enum": ["agent", "human"],
      "default": "agent",
      "description": "Who supplied the recorded fact or judgment. Omission means agent origin."
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit_ref": { "type": "string", "pattern": "^commit:[0-9a-f]{40}$" }
  }
}
