{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/ticket-outcome.v2.json",
  "title": "VibeHub Ticket Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "outcome_id", "ticket_id", "binding_state", "status", "accepted_acceptance_ids", "unresolved_acceptance_ids", "evidence_ids", "summary", "closed_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "ticket_outcome" },
    "outcome_id": { "$ref": "#/$defs/id" },
    "ticket_id": { "$ref": "#/$defs/id" },
    "binding_state": { "enum": ["bound", "legacy-pending-reconstruction", "legacy-unresolved"] },
    "binding_origin": { "enum": ["native", "reconstructed"] },
    "contract_revision": { "$ref": "#/$defs/contract_ref" },
    "unresolved": { "$ref": "#/$defs/unresolved" },
    "status": { "enum": ["successful", "partial", "failed", "deviated"] },
    "accepted_acceptance_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "unresolved_acceptance_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "summary": { "$ref": "#/$defs/text" },
    "closed_at": { "type": "string", "format": "date-time" },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["subagent", "separate_session", "different_human"] },
        "note": { "$ref": "#/$defs/text" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "binding_state": { "const": "bound" } } },
      "then": { "required": ["binding_origin", "contract_revision"], "not": { "required": ["unresolved"] } },
      "else": { "not": { "anyOf": [{ "required": ["binding_origin"] }, { "required": ["contract_revision"] }] } }
    },
    {
      "if": { "properties": { "binding_state": { "const": "legacy-unresolved" } } },
      "then": { "required": ["unresolved"] },
      "else": { "not": { "required": ["unresolved"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "identity"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "identity": { "$ref": "#/$defs/identity" }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "attempted_refs"],
      "properties": {
        "reason": { "enum": ["missing-history", "ambiguous-history"] },
        "attempted_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
