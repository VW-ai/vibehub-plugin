{
  "schema_version": 1,
  "presenter": "vibehub-review",
  "planning_contracts": {
    "dependency_hygiene": "../../vibehub-core/contracts/dependency-hygiene.json"
  },
  "resource_policy": {
    "scope": "current-agent-task",
    "reuse_live_host": true,
    "reuse_browser_tab": true,
    "cross_task_discovery": "forbidden",
    "on_user_entry": "open-unified-dashboard",
    "entry_contract": "../../vibehub-core/contracts/session-entry.md",
    "entry_failure": "continue-in-conversation"
  },
  "events": [
    {
      "event": "ticket-defined",
      "owner": "vibehub-ticket",
      "presentation": "review",
      "surface": "contract",
      "continuation": "report",
      "human_boundary": false,
      "fallback": "conversation"
    },
    {
      "event": "ticket-updated",
      "owner": "vibehub-ticket",
      "presentation": "review",
      "surface": "log",
      "continuation": "report",
      "human_boundary": false,
      "fallback": "conversation"
    },
    {
      "event": "pr-review-ready",
      "owner": "vibehub-pr",
      "presentation": "review",
      "surface": "graph",
      "continuation": "report",
      "human_boundary": false,
      "fallback": "conversation"
    },
    {
      "event": "explicit-review",
      "owner": "vibehub-review",
      "presentation": "review",
      "surface": "requested",
      "continuation": "report",
      "human_boundary": false,
      "fallback": "conversation"
    }
  ]
}
