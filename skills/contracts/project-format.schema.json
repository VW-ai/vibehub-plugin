{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehub.dev/schemas/project-format.v1.json",
  "title": "VibeHub Project Format",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "format_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "vibehub_project" },
    "format_version": { "type": "integer", "minimum": 1 }
  }
}
